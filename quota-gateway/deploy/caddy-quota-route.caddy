# Put this block before both the /responses/compact handler and the generic
# Sub2API API matcher. The compatibility gateway proxies the request to the
# unmodified upstream without creating quota holds or enforcing a local cap.
@quota_api path /v1/* /responses* /models* /api/openai/* /api/anthropic/*
handle @quota_api {
  reverse_proxy 127.0.0.1:18193
}
