PORT=3000
SUB2API_BASE_URL=http://host.docker.internal:18080
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
PAY_SERVICE_BASE_URL=http://host.docker.internal:18080
MINIMUM_REMAINING_HOURS=24
# Runs the owned fixed-midnight daily quota catch-up job. The task uses a
# PostgreSQL advisory lock, so only one service replica can update at a time.
DAILY_RESET_TIME_ZONE=Asia/Shanghai
DAILY_RESET_POLL_INTERVAL_MS=60000
DAILY_RESET_BATCH_SIZE=200
